  maxUserConnections Int            @default(25)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?      @db.Timestamptz(6)

  account          HostingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  databaseInstance DatabaseInstance @relation(fields: [databaseInstanceId], references: [id], onDelete: Restrict)
  grants           DatabaseGrant[]

  @@unique([databaseInstanceId, dbUsername, allowedHostPattern])
  @@index([accountId, engine, deletedAt])
  @@index([resellerId])
  @@map("database_accounts")
}

model DatabaseGrant {
  id                String                 @id @default(uuid()) @db.Uuid
  accountId         String                 @db.Uuid
  resellerId        String?                @db.Uuid
  hostedDatabaseId  String                 @db.Uuid
  databaseAccountId String                 @db.Uuid
