// =============================================================================
// 5. CUSTOMER HOSTED DATABASE WORKLOADS (ISOLATED FROM PANEL DB)
// =============================================================================

model DatabaseInstance {
  id                              String         @id @default(uuid()) @db.Uuid
  name                            String         @unique @db.VarChar(120)
  engine                          DatabaseEngine
  version                         String         @db.VarChar(32)
  host                            String         @default("127.0.0.1") @db.VarChar(255)
  port                            Int
  socketPath                      String?        @db.VarChar(255)
  // MUST ALWAYS BE FALSE for customer workload instances to enforce strict isolation
  isPanelInstance                 Boolean        @default(false)
  maxConnections                  Int            @default(200)
  adminUsername                   String         @db.VarChar(64)
  // Envelope-encrypted administrative credential reference (AES-256-GCM)
  adminEncryptedSecretCiphertext  String         @db.Text
  adminSecretKeyId                String         @db.VarChar(128)
  adminSecretIv                   String         @db.VarChar(64)
  adminSecretAuthTag              String         @db.VarChar(64)
  isHealthy                       Boolean        @default(true)
  createdAt                       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt                       DateTime?      @db.Timestamptz(6)

  databases        HostedDatabase[]
  databaseAccounts DatabaseAccount[]

  @@unique([engine, host, port])
  @@index([engine, isPanelInstance, isHealthy])
  @@map("database_instances")
}

model HostedDatabase {
  id                 String         @id @default(uuid()) @db.Uuid
  accountId          String         @db.Uuid
  resellerId         String?        @db.Uuid
  databaseInstanceId String         @db.Uuid
  engine             DatabaseEngine
  databaseName       String         @db.VarChar(64)
  characterSet       String         @default("utf8mb4") @db.VarChar(32)
  collation          String         @default("utf8mb4_unicode_ci") @db.VarChar(64)
  sizeBytes          BigInt         @default(0)
  quotaMb            Int            @default(2048)
  isReadOnlyLocked   Boolean        @default(false)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?      @db.Timestamptz(6)

  account          HostingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  databaseInstance DatabaseInstance @relation(fields: [databaseInstanceId], references: [id], onDelete: Restrict)
  grants           DatabaseGrant[]

  @@unique([databaseInstanceId, databaseName])
  @@index([accountId, engine, deletedAt])
  @@index([resellerId])
  @@map("hosted_databases")
}

model DatabaseAccount {
  id                 String         @id @default(uuid()) @db.Uuid
  accountId          String         @db.Uuid
  resellerId         String?        @db.Uuid
  databaseInstanceId String         @db.Uuid
  engine             DatabaseEngine
  dbUsername         String         @db.VarChar(64)
  allowedHostPattern String         @default("127.0.0.1") @db.VarChar(128)
