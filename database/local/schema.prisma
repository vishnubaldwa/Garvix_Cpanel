  resellerId          String?   @db.Uuid
  metricScope         String    @default("HOST") @db.VarChar(32)
  cpuUsagePercent     Decimal   @db.Decimal(5, 2)
  loadAvg1m           Decimal   @db.Decimal(6, 2)
  memoryUsedMb        Int
  memoryAvailableMb   Int
  swapUsedMb          Int       @default(0)
  diskUsedMb          BigInt
  diskReadIops        Int       @default(0)
  diskWriteIops       Int       @default(0)
  netRxBytesPerSec    BigInt    @default(0)
  netTxBytesPerSec    BigInt    @default(0)
  // Explicit flag to distinguish synthetic/test seed telemetry from live agent metrics
  isMockData          Boolean   @default(false)
  sampledAt           DateTime  @default(now()) @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime? @db.Timestamptz(6)

  account HostingAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, sampledAt(sort: Desc)])
  @@index([metricScope, isMockData, sampledAt(sort: Desc)])
  @@index([resellerId])
  @@map("monitoring_samples")
}

model LocalSecurityEvent {
  id             String                @id @default(uuid()) @db.Uuid
  accountId      String?               @db.Uuid
  resellerId     String?               @db.Uuid
  actorUserId    String?               @db.Uuid
  severity       SecurityEventSeverity
  detectorSource String                @db.VarChar(64)
  eventType      String                @db.VarChar(120)
  sourceIp       String                @db.VarChar(64)
  actionTaken    String                @db.VarChar(120)
  detailsJson    Json                  @db.JsonB
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?             @db.Timestamptz(6)

  account   HostingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  actorUser LocalUser?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([accountId, severity, createdAt(sort: Desc)])
  @@index([sourceIp, createdAt(sort: Desc)])
  @@index([resellerId])
  @@map("security_events")
}

model LocalAuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String?   @db.Uuid
  resellerId    String?   @db.Uuid
  actorUserId   String?   @db.Uuid
  actorUsername String    @db.VarChar(64)
  actorRoleCode String    @db.VarChar(80)
  action        String    @db.VarChar(150)
  targetType    String    @db.VarChar(100)
  targetId      String    @db.VarChar(128)
  ipAddress     String    @db.VarChar(64)
  userAgent     String?   @db.VarChar(512)
  requestId     String    @db.VarChar(128)
  changesJson   Json      @db.JsonB
  integrityHash String    @db.VarChar(128)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  account   HostingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  actorUser LocalUser?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([resellerId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_logs")
}
